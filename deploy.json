{
  "version": 1,
  "project": "contracts/locket",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "auth@example.invalid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "CLICKWRAP_SIGNING_KEY",
      "environment": "CLICKWRAP_SIGNING_KEY",
      "optional": true
    },
    {
      "binding": "NOTICE_RESEND_WEBHOOK_SECRET",
      "environment": "NOTICE_RESEND_WEBHOOK_SECRET",
      "optional": true
    },
    {
      "binding": "POSTMARK_SERVER_TOKEN",
      "environment": "POSTMARK_SERVER_TOKEN",
      "optional": true
    },
    {
      "binding": "POSTMARK_INBOUND_SECRET",
      "environment": "POSTMARK_INBOUND_SECRET",
      "optional": true
    },
    {
      "binding": "POSTMARK_REPLY_DOMAIN",
      "environment": "POSTMARK_REPLY_DOMAIN",
      "optional": true
    },
    {
      "binding": "QUICKBOOKS_ACCESS_TOKEN",
      "environment": "QUICKBOOKS_ACCESS_TOKEN",
      "optional": true
    },
    {
      "binding": "QUICKBOOKS_REALM_ID",
      "environment": "QUICKBOOKS_REALM_ID",
      "optional": true
    },
    {
      "binding": "QUICKBOOKS_SANDBOX",
      "environment": "QUICKBOOKS_SANDBOX",
      "optional": true
    }
  ],
  "crons": [
    "0 * * * *"
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
